# Per-account secrets (auth/bearer/csrf tokens) live in accounts.yaml now,
# not here -- copy accounts.yaml.example to accounts.yaml and fill those in.
# See README's Credentials section for how to extract them.

# Docker volume-mount paths
HOST_OUTPUT_DIR=./data
CONTAINER_OUTPUT_DIR=/app/data
OUTPUT_DIR=/app/data
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OLLAMA_BASE_URL only relevant for accounts running the Agent Runtime (roadmap Phase 4 --
# i.e. sockpuppet_config.persona_prompt is configured). Powers the LLM
# Decision stage via langchain-ollama against a LOCAL Ollama server
# (`ollama serve`, with DEFAULT_MODEL from src/runtime/decision.py pulled --
# `ollama pull qwen2.5:14b`). No API key needed.
#
# Default is http://localhost:11434, which works when running `python
# src/main.py` directly on the same machine as Ollama. Running via `docker
# compose up` instead? "localhost" then means the CONTAINER, not your host
# -- set this to something the container can actually reach, e.g.
# http://host.docker.internal:11434 on Docker Desktop (Mac/Windows). On
# native Linux Docker, host.docker.internal isn't automatic; either add
# `extra_hosts: ["host.docker.internal:host-gateway"]` to docker-compose.yml,
# or point this at the host's actual LAN/bridge IP instead.