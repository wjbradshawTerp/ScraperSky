.env
# Every *accounts.yaml (accounts.yaml, testrun_accounts.yaml, ...) holds live
# per-account credentials. accounts.yaml.example is the only committed template.
accounts.yaml
*accounts.yaml
!accounts.yaml.example

# Real account lists that name specific third-party accounts. The
# untrustworthy_sources list labels named real accounts as "untrustworthy",
# so the real ids stay local; untrustworthy_sources.json.example documents
# the shape. (follow_user_ids.json is committed -- it's just a follow list,
# it makes no claim about the accounts in it.)
untrustworthy_sources.json
# Backups of accounts.yaml carry the same live credentials as the original.
accounts.yaml.bak*
# Output of extract_account_tokens.py -- holds live auth/csrf tokens.
*.tokens.json
# Mercury case-study inventories -- same reason: they label named real
# accounts as untrustworthy (news_sources.json is ignored alongside them so
# the case study's lists stay together, local-only).
untrustworthy.json
untrustworthy_top434.json
news_sources.json

data/*
!data/.gitkeep
logs/

personas/*
!personas/example_persona.txt.example

__pycache__/
*.pyc
*.pyo
*.pyd

venv/
.venv/

.DS_Store
Thumbs.db

.vscode/
.idea/

dist/
build/
*.egg-info/