# Per-account credentials and optional per-account behavioral overrides.
#
# This file contains secrets (auth/bearer/csrf tokens for each X/Twitter
# account) -- copy it to accounts.yaml and fill in real values. accounts.yaml
# is gitignored, same as .env, and must never be committed.
#
# See README's Credentials section for how to extract auth_token/
# bearer_token/csrf_token for a given account (same DevTools steps as before,
# just once per account instead of once per repo).
accounts:
  - name: primary
    auth_token: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    bearer_token: "Bearer xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    csrf_token: xxxxxxxxxxxxxxxxxxxxxxxx
    # Everything below is optional. Every one of config.yaml's top-level
    # keys can be overridden here -- platform, scroll_delay,
    # fetch_max_retries, fetch_retry_backoff, empty_batch_backoff_base,
    # empty_batch_backoff_max, empty_batch_backoff_jitter, timezone,
    # data_collection, actions, account_lists, sockpuppet_config,
    # experiment_design, intervention. Any key
    # an account doesn't set falls back to the matching key in config.yaml
    # (dict-valued keys like data_collection/actions/account_lists/
    # sockpuppet_config/experiment_design/intervention merge shallowly --
    # e.g. an account can override just `targets` below and still inherit
    # `search_query` from config.yaml).
    data_collection:
      targets:
        - home
    actions:
      follow_all: true
    account_lists:
      follow_list: follow_user_ids.json

  # Uncomment and fill in to run a second account alongside the first --
  # each runs in its own thread with its own credentials, agent-state file,
  # and output namespace (data/<date>/twitter/<name>/). This one also shows
  # overriding scalar config.yaml keys, not just the dict-valued ones above.
  # - name: secondary
  #   auth_token: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  #   bearer_token: "Bearer xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  #   csrf_token: xxxxxxxxxxxxxxxxxxxxxxxx
  #   scroll_delay: 4          # overrides config.yaml's default for this account only
  #   timezone: UTC            # overrides config.yaml's default for this account only
  #   data_collection:
  #     targets:
  #       - following

  # ---------------------------------------------------------------------
  # REFERENCE ONLY -- every field this codebase currently reads from an
  # account entry, in one place, so nothing gets missed when writing a
  # real config. Not meant to be uncommented and used verbatim (it mixes
  # incompatible settings, e.g. a single `data_collection.targets` entry
  # AND multiple targets, cold-start AND Agent Runtime mode at once).
  # When adding a new per-account-overridable field to src/config.py,
  # add it here too, with a comment, so this stays exhaustive.
  # ---------------------------------------------------------------------
  # - name: reference_example              # required. Namespaces this account's output/state/logs.
  #   auth_token: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx           # required
  #   bearer_token: "Bearer xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # required
  #   csrf_token: xxxxxxxxxxxxxxxxxxxxxxxx                          # required
  #
  #   # --- Scalar overrides of config.yaml's top-level defaults ---
  #   platform: twitter                    # which scraper implementation (see src/scraper/__init__.py's SCRAPER_REGISTRY)
  #   scroll_delay: 2                      # seconds between timeline fetch requests
  #   fetch_max_retries: 5                 # retries for one pagination cursor before giving up
  #   fetch_retry_backoff: 5               # base seconds for retry backoff (x attempt number)
  #   empty_batch_backoff_base: 5          # base seconds for the all-duplicates backoff (roughly doubles each consecutive empty batch)
  #   empty_batch_backoff_max: 300         # cap in seconds for that backoff
  #   empty_batch_backoff_jitter: 0.2      # randomize each backoff wait by +/- this fraction (0.2 = +/-20%)
  #   timezone: America/New_York           # IANA zoneinfo key, used for output file timestamps
  #
  #   # --- data_collection: what gets observed, and how it's logged ---
  #   data_collection:
  #     targets:                           # observation feeds: home (X's "Home" tab, GraphQL HomeTimeline) /
  #       - home                            # following (X's "Following" tab, GraphQL HomeLatestTimeline) / search.
  #       - following                       # Several are allowed in both modes: Agent Runtime snapshots each one
  #                                          # per activation; the scripted path round-robins pages across them.
  #       - engagement_log                  # derived data stream: every action this account performs
  #       - intervention_history            # derived data stream: what the intervention did to this account
  #     search_query: trump                 # required if "search" is a target; plain keywords only
  #     observation_frequency: every_visit  # only every_visit is implemented (one observation per activation)
  #     logging: full                       # full (default) or minimal -- controls whether the Agent
  #                                          # Runtime's runtime_log JSONL includes the constructed prompt,
  #                                          # raw model output, and observed post, or just the
  #                                          # decision/execution trace
  #
  #   # --- actions: non-LLM scripted actions run once at startup ---
  #   actions:
  #     follow_all: true                    # run follow_all() at startup, following everyone in the follow_list account list
  #
  #   # --- account_lists: named collections of accounts (arbitrary names) ---
  #   account_lists:
  #     follow_list: follow_user_ids.json             # consumed by follow_all()
  #     untrustworthy_sources: untrustworthy.json     # e.g. referenced by sockpuppet_config below
  #     trustworthy_sources: trustworthy_sources.json # e.g. referenced by sockpuppet_config below
  #     prominent_news_sources: news_sources.json     # e.g. referenced by sockpuppet_config below
  #
  #   # --- sockpuppet_config: cold-start initialization + Agent Runtime ---
  #   sockpuppet_config:
  #     account_lists:                      # which account_lists (by name, from above) cold-start draws candidates from
  #       - untrustworthy_sources
  #       - prominent_news_sources
  #     initialization_params:              # enables cold-start (roadmap Phase 4a) when set
  #       min_follows: 15                   # stop following once at least this many accounts are followed
  #       min_engagements: 15                # stop liking/reposting once at least this many engagement events are recorded
  #       max_initialization_days: 3         # give up after this many days even if criteria above aren't met
  #       max_follows: 15                    # cap on cold-start follows. Must be >= min_follows, or cold-start
  #                                           # could never satisfy its own stopping criteria (validated at startup).
  #       follow_seed: 42                    # optional. Makes the follow draw reproducible. Precedence:
  #                                           # this -> the experiment's PERSISTED randomization seed -> the
  #                                           # configured randomization seed -> 0. The seed actually used is
  #                                           # logged and stored in agent_state.internal_memory.
  #       follow_mix:                        # optional. Draw exactly this many from each named account_list,
  #         untrustworthy_sources: 5          # making the follow graph's composition a controlled design
  #         trustworthy_sources: 10           # parameter. OMIT to draw from the pooled union instead, which
  #                                           # lands proportional to how long each file happens to be --
  #                                           # usually NOT what you want when exposure to one list is the
  #                                           # thing being measured. Names must appear in
  #                                           # sockpuppet_config.account_lists; the total must not exceed
  #                                           # max_follows (both validated at startup).
  #                                           # The draw is namespaced per account, so every sockpuppet gets a
  #                                           # different mix while staying reproducible from the one seed.
  #     persona_prompt: personas/example_persona.txt   # path to a persona text file -- enables Agent Runtime mode (roadmap Phase 4) when set.
  #                                           # Also makes cold-start persona-driven: initialization runs the same
  #                                           # decision cycle, restricted to follow/like/repost (no mute).
  #     agent_id: mercury_p017              # stable id for this sockpuppet in the experiment; defaults to the account name
  #     phase: pre_treatment                # static stand-in, used ONLY when experiment_design.treatment_arms (below) is NOT set for this account
  #     treatment_arm: control              # static stand-in, used ONLY when experiment_design.treatment_arms (below) is NOT set for this account
  #     activation_schedule:                 # how long the Agent Runtime waits between decision cycles
  #       distribution: truncated_powerlaw   # uniform, truncated_powerlaw, or poisson
  #       min_interval: 15m                  # shorthand duration: Ns / Nm / Nh / Nd
  #       max_interval: 6h
  #     action_rate_limits:                  # per-action pacing on top of the platform's own limits;
  #       retweet:                           # an action with no entry here is uncapped. A capped
  #         max_per_hour: 4                  # decision becomes a logged no_action with
  #         min_interval: 8m                 # no_action_reason "rate_capped" -- it never blocks the
  #                                           # activation. These retweet values are sized from live
  #                                           # observation (35% success rate, misleading refusals),
  #                                           # not a documented limit -- see ROADMAP.md.
  #
  #   # --- experiment_design: experiment-level metadata + Experiment Orchestrator config (roadmap Phase 5) ---
  #   experiment_design:
  #     experiment_name: mercury_muting      # used to build a readable experiment_id (<experiment_name>::<account_name>)
  #     treatment_arms:                      # setting this OPTS THIS ACCOUNT INTO the shared Experiment Orchestrator --
  #       - control                          # every account that sets treatment_arms must agree on experiment_name/
  #       - treatment                        # randomization/phase_durations (validated at startup); phase/treatment_arm
  #                                           # above are then ignored in favor of the orchestrator's real state
  #     randomization:
  #       method: simple_random              # only simple_random is implemented (stratified/blocked are future work)
  #       seed: 42                           # makes the treatment-arm split reproducible. Assignment happens at the END
  #                                           # of pre_treatment (not startup), then persisted -- so agents run a
  #                                           # condition-blind baseline first, and a later seed change never
  #                                           # silently reassigns an already-committed experiment
  #       ratios:                            # must sum to 1.0 across every arm above; omit for an even split
  #         control: 0.5
  #         treatment: 0.5
  #     recovery_policy:                     # how an account recovers from a failed activation
  #       max_consecutive_failures: 5        # give up on this account after this many in a row (default 5)
  #       backoff: 1m                        # wait after the first failure, doubled per consecutive failure
  #       max_backoff: 30m                   # cap on that wait
  #     phase_durations:                     # driving automatic pre_treatment -> treatment -> post_treatment
  #       initialization: adaptive           # ends on initialization_params, not a clock (never a fixed duration)
  #       pre_treatment: 3d                  # transitions; a phase with no entry here never auto-transitions --
  #       treatment:                         # the experiment just stays there. Each entry is either a bare
  #         max_duration: 7d                 # shorthand duration (e.g. "3d", as pre_treatment/post_treatment
  #         max_action_count: 10000          # show), or {max_duration, max_action_count} to transition on
  #       post_treatment: 3d                 # whichever comes first -- max_action_count counts real, agent-
  #                                           # selected actions (not no_action) by any ONE participating account.
  #                                           # Whatever ends a phase, the orchestrator will never actually leave
  #                                           # it while an intervention it triggered is still pending/running.
  #                                           # Finishing post_treatment COMPLETES the experiment: agents stop and
  #                                           # the process exits cleanly.
  #
  #   # --- intervention: orchestrator-triggered bulk action (paper section 3.1) ---
  #   # Only read for accounts with experiment_design.treatment_arms set above. Fires exactly
  #   # once, at execution_time, for every account whose treatment arm is in applies_to_arms --
  #   # reuses execute_action(), the same dispatcher the Agent Runtime and cold-start already
  #   # use, not a separate action path. Every target gets a real attempt (retried with
  #   # backoff), and the phase won't advance until the whole intervention has finished.
  #   intervention:
  #     action: mute                         # any execute_action() action
  #     target_accounts: untrustworthy_sources       # a name from account_lists above
  #     selection_rule: random70             # `all`, or randomNN for a random NN% sampled per sockpuppet
  #     execution_time: end_of_pre_treatment # end_of_pre_treatment (as `treatment` begins) or end_of_treatment
  #     applies_to_arms:                     # which treatment_arms values above receive this intervention
  #       - treatment
