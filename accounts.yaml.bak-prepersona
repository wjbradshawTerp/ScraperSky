    # Everything below is optional. Every one of config.yaml's top-level
    # keys can be overridden here -- platform, scroll_delay,
    # fetch_max_retries, fetch_retry_backoff, timezone, data_collection,
    # actions, account_lists. Any key an account doesn't set falls back to
    # the matching key in config.yaml (dict-valued keys like
    # data_collection/actions/account_lists merge shallowly -- e.g. an
    # account can override just `targets` below and still inherit
    # `search_query` from config.yaml).
    data_collection:
      targets:
        - home         # For You feed (GraphQL HomeTimeline)
        - following    # reverse-chronological Home timeline (GraphQL HomeLatestTimeline)
        - engagement_log
        - intervention_history
    actions:
      follow_all: true
    account_lists:
      follow_list: follow_user_ids.json
    experiment_design:
      experiment_name: bradshaw_action_count_test
      treatment_arms:
        - control
        - treatment
      randomization:
        method: simple_random
        seed: 42
        ratios:
          control: 0.5
          treatment: 0.5
      phase_durations:
        pre_treatment:
          max_duration: 30m
          max_action_count: 3
        treatment:
          max_duration: 30m
          max_action_count: 3
        post_treatment:
          max_duration: 30m
          max_action_count: 3
    intervention:
      action: mute
      target_accounts: untrustworthy_sources
      selection_rule: random70
      execution_time: end_of_pre_treatment
      applies_to_arms:
        - treatment

